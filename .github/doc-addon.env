# Add-on identifier for doc publish (Azure paths, archive names, PR preview URLs).
DOC_ADDON_NAME=ncs-knx-iot

# Checkout folder under ${GITHUB_WORKSPACE}/ (doc_build + on_pr west layout).
# doc_build.yml reads this file before the full checkout (sparse bootstrap).
DOC_ADDON_DIR=knx-iot

# When true, doc_build runs west init + update before make html (requires west.yml).
# Accepted values: true, false (case-insensitive).
WEST_UPDATE=true

# Comma-separated west manifest project names to fetch (manifest.project-filter: -.*,+name,...).
WEST_MODULES=sdk-knx-iot-stack
